{
  "expo": {
    "name": "Step",
    "slug": "Step",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB2vBkKP7ia8Ri5EHA3SoC4ujr7-gB7M7I"
        }
      },
      "permissions": [
        "RECORD_AUDIO",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS"
      ],
      "package": "com.nimash79.Step"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-image-picker"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "3be8e5c4-32a3-456d-9f8f-e3cfeadee610"
      }
    }
  }
}
